# docker/Dockerfile.backend
# Builds the Python FastAPI + Celery container

# Start from official Python image (slim = smaller size)
FROM python:3.11-slim

# Set working directory inside the container
WORKDIR /app

# ── Install system dependencies ───────────────────────────────────────────────
# These are needed by some Python packages (OpenCV, libmagic, Tesseract OCR)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \          
    libgl1-mesa-glx \    
    libglib2.0-0 \       
    tesseract-ocr \      
    tesseract-ocr-eng \  
    ffmpeg \             
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Install Python dependencies ───────────────────────────────────────────────
# Copy requirements first (Docker caches this layer if requirements didn't change)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Copy application code ─────────────────────────────────────────────────────
COPY . .

# Create upload directory (fallback when MinIO isn't available)
RUN mkdir -p uploads

# ── Expose port ───────────────────────────────────────────────────────────────
EXPOSE 8000

# Default command (overridden in docker-compose.yml)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
