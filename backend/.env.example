# ── Copy this file to .env and fill in your values ────────────────────────────
# NEVER commit your actual .env file to GitHub!

# Database (PostgreSQL)
# If running locally: postgres://localhost:5432/astrashield
DATABASE_URL=postgresql://username:password@localhost:5432/astrashield

# Database (MongoDB)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=astrashield

# Redis (background task queue)
REDIS_URL=redis://localhost:6379/0

# MinIO (file storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=astrashield-uploads
MINIO_SECURE=false

# JWT Security (make this a long random string!)
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App Settings
DEBUG=true
MAX_FILE_SIZE_MB=50
ALLOWED_ORIGINS=http://localhost:3000
